# ------------------------------------------------------------------
# Phynexora website — environment variables
# Copy to .env.local (development) or set in your hosting provider.
# NEXT_PUBLIC_* values are visible in the browser. NEVER put secrets in them.
# ------------------------------------------------------------------

# Public site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.phynexora.com

# Contact details — the ONLY place these are configured
NEXT_PUBLIC_WHATSAPP_NUMBER=+94711523123
NEXT_PUBLIC_WHATSAPP_DISPLAY=+94 71 152 3123
NEXT_PUBLIC_CONTACT_EMAIL=phynexora@gmail.com
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_LOCATION=
NEXT_PUBLIC_WORKING_HOURS=
NEXT_PUBLIC_LEGAL_NAME=Phynexora

# Social profiles (leave empty to show as "coming soon")
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_GITHUB=

# Chatbot: "guided" (no AI) or "ai" (requires backend Ai__* settings)
NEXT_PUBLIC_CHAT_MODE=guided

# Spam protection — Cloudflare Turnstile site key (secret goes in the backend)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Analytics (optional — set one or both)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_HOST=https://plausible.io

# ---------------- Server-only (never exposed to the browser) -------
# ASP.NET Core API base URL. If unset: dev = mock success, prod = 503.
API_BASE_URL=http://localhost:5080
# Shared key the Next.js server sends to the API (X-Api-Key). Must match backend Security__ClientApiKey.
BACKEND_API_KEY=change-me-long-random-string
